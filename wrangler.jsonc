{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartssify-clone-art",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    // Teklif taleplerinin gideceği adres (gizli değil). RESEND_API_KEY ve
    // opsiyonel QUOTE_FROM_EMAIL secret olarak `wrangler secret put` ile eklenir.
    "QUOTE_TO_EMAIL": "selinefe@standatelier.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rumicarts-db",
      "database_id": "2f6eef11-4e1d-4532-aa80-5080862bc84a",
    },
  ],
  // Marka örnek görselleri (admin'den yüklenen) burada saklanır; /assets/<key>
  // ile worker üzerinden servis edilir.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rumicarts-assets",
    },
  ],
}
